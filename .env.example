# Referencia de configuración. n8n Cloud usa credenciales en su interfaz.
# Este archivo no conecta automáticamente variables con los nodos.
TELEGRAM_BOT_TOKEN=CONFIGURAR_EN_CREDENCIAL_N8N
TELEGRAM_ALLOWED_USER_ID=CONFIGURAR_PRIVADAMENTE
N8N_BASE_URL=https://TU_INSTANCIA_N8N
N8N_DATA_TABLE_ID=CONFIGURAR_TABLA
AULA_VOICE_HEADER_NAME=X-Aula-Key
AULA_VOICE_HEADER_VALUE=CONFIGURAR_SOLO_EN_N8N_Y_SECRETO_ELEVENLABS
ELEVENLABS_AGENT_ID=CONFIGURAR_AGENT_ID_PUBLICO

